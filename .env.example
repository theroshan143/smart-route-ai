# ── Application ──────────────────────────────────────
MOCK_MODE=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ─────────────────────────────────────────
# PostgreSQL (used in Docker / production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartroute
# Falls back to SQLite if DATABASE_URL is not set:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Qdrant ───────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trip_patterns

# ── Google Places API ────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ── OpenRouteService ─────────────────────────────────
ORS_API_KEY=

# ── LLM Provider ────────────────────────────────────
# Supported: openai, google
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_SUGGEST=30/minute
RATE_LIMIT_DEFAULT=60/minute
